{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "sofyra-jewels",
  "main": "server.ts",
  "compatibility_date": "2024-09-23",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application"
  },
  "r2_buckets": [
    {
      "binding": "SOFYRA_IMAGES",
      "bucket_name": "sofyraimages"
    }
  ]
}
